<!-- testspec -->
<?xml version="1.0" encoding="utf-8"?>

<Window
    window:width="200"
    window:height="200"
    var:position="0"
    window:type="app"
    title="test-window"
    >
    <include source="path" />

    <!-- either micro-c or a custom scripting language -->
    <subscript name="testscript" type="module">
        fn add(a, b) {
            return a + b;
        }
    </subscript>
    <DisplayGroup name="container">
        <Text position:x="20" position:y="20" color="0xFFFFFF">
            Test Text
        </Text>
        <Text position:x="20" position:y="50" color="0xFFFFFF">
            Add: {testscript::add(1,2)}
        </Text>
    </DisplayGroup>
</Window>
